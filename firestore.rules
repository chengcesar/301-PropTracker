rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Properties: owner has full access; viewers with active share (denormalized in users/{uid}.viewers) can read
      match /properties/{propertyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.viewers;
      }

      // Settings subcollection
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Shares ────────────────────────────────────────────────────────────────
    match /shares/{shareId} {
      // Owner: full read/write on their own shares
      allow read, write: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Grantee: read shares addressed to them (by UID after acceptance, or by email before)
      allow read: if request.auth != null
        && (resource.data.granteeUid == request.auth.uid
            || resource.data.granteeEmail == request.auth.token.email);

      // Acceptance: grantee can set their uid + status on a pending share addressed to their email
      allow update: if request.auth != null
        && resource.data.granteeEmail == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['granteeUid', 'status', 'acceptedAt']);

      // Owner can create new shares
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
    }

  }
}
