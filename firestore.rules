rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Admins can read any user doc (for the admin dashboard)
      allow read, write: if isAdmin();

      // Properties: owner has full access; active viewers can read
      match /properties/{propertyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/users/$(uid)/viewers/$(request.auth.uid));
        // Admins can read any user's properties
        allow read: if isAdmin();
      }

      // Viewers subcollection: owner has full control; grantee can create their own viewer doc on invite acceptance
      match /viewers/{viewerUid} {
        allow read, write, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == viewerUid;
      }

      // Settings subcollection
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Invite token index ───────────────────────────────────────────────────
    // Any authenticated user can read a token doc by exact path (no collection query).
    // This avoids Firestore rejecting queries where rules reference resource.data fields.
    match /inviteTokens/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Mail (Firebase Trigger Email extension) ──────────────────────────────
    match /mail/{docId} {
      allow create: if request.auth != null;
    }

    // ── Shares ────────────────────────────────────────────────────────────────
    match /shares/{shareId} {
      // Owner: full read/write on their own shares
      allow read, write: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Grantee: read shares addressed to them (by UID after acceptance, or by email before)
      allow read: if request.auth != null
        && (resource.data.granteeUid == request.auth.uid
            || resource.data.granteeEmail == request.auth.token.email);

      // Acceptance: grantee can set their uid + status on a pending share addressed to their email
      allow update: if request.auth != null
        && resource.data.granteeEmail == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['granteeUid', 'status', 'acceptedAt']);

      // Owner can create new shares
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
    }

  }
}
