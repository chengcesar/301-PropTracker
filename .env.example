# PropTracker Environment Variables

# ═══════════════════════════════════════════════════════════════════
# CLIENT-SIDE (Vite)
# ═══════════════════════════════════════════════════════════════════
# Firebase client configuration
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Enable Authentication → Google provider (and Email/Password if needed)
# 3. Create a Firestore database
# 4. Copy your web app config values below

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin emails (comma-separated) with admin privileges
VITE_ADMIN_EMAILS=

# ═══════════════════════════════════════════════════════════════════
# SERVER-SIDE (Vercel Serverless Functions)
# ═══════════════════════════════════════════════════════════════════
# Firebase Admin SDK service account credentials
# Used by the Agent API (/api/agent-portfolio)
#
# To get this:
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key"
# 3. Download the JSON file
# 4. Copy the ENTIRE JSON content as a single-line string
# 5. Set it as this environment variable in Vercel
#
# IMPORTANT: Never commit this value or expose it in client-side code
# Set this ONLY in Vercel project settings, NOT in .env files

FIREBASE_SERVICE_ACCOUNT_JSON=
